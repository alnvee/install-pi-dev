# install-pi-dev configuration
#
# Copy to .env (or export in your shell) to override installer defaults.
# All variables are optional.

# --- Source ---

# GitHub repo + branch to install from when streaming (curl | sh).
# Default: https://github.com/alnvee/install-pi-dev / main
#PI_INSTALL_REPO_URL=https://github.com/alnvee/install-pi-dev
#PI_INSTALL_REPO_BRANCH=main

# Use a local .pi checkout instead of downloading (takes precedence over
# PI_INSTALL_REPO_URL). Must contain .pi/agent/settings.json.
#PI_INSTALL_SOURCE_DIR=/path/to/local/checkout

# --- Behavior ---

# 1 to print the install plan and exit without making changes.
#PI_INSTALL_DRY_RUN=0

# 1 to skip tarball checksum verification.
#PI_INSTALL_SKIP_CHECKSUM=0

# 1 to proceed even if another pi instance is running (its session state in
# $HOME/.pi would be destroyed by the install).
#PI_INSTALL_FORCE=0

# --- Integrity ---

# Expected SHA256 of the release tarball (optional, skipped when empty).
# Generate with: curl -sL <archive_url> | sha256sum
#PI_INSTALL_RELEASE_SHA256=

# --- Mattpocock skills refresh ---

# Upstream repo + branch for the mattpocock skills refresh.
# Default: https://github.com/mattpocock/skills / main
#PI_MATTPOCOCK_SKILLS_REPO=https://github.com/mattpocock/skills
#PI_MATTPOCOCK_SKILLS_BRANCH=main
