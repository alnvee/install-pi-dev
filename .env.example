# install-pi-dev configuration
#
# Copy to .env (or export in your shell) to override installer defaults.
# All variables are optional.

# --- Source ---

# GitHub repo + branch to install from when streaming (curl | sh).
# Default: https://github.com/alnvee/install-pi-dev / main
#PI_INSTALL_REPO_URL=https://github.com/alnvee/install-pi-dev
#PI_INSTALL_REPO_BRANCH=main

# Use a local .pi checkout instead of downloading (takes precedence over
# PI_INSTALL_REPO_URL). Must contain .pi/agent/settings.json.
#PI_INSTALL_SOURCE_DIR=/path/to/local/checkout

# --- Behavior ---

# 1 to print the install plan and exit without making changes.
#PI_INSTALL_DRY_RUN=0

# 1 to skip tarball checksum verification.
#PI_INSTALL_SKIP_CHECKSUM=0

# 1 to proceed even if another pi instance is running (its session state in
# $HOME/.pi would be destroyed by the install).
#PI_INSTALL_FORCE=0

# --- NotebookLM (Gemini Notebook research backend, optional) ---

# The /nlm extension ships with every install and is the NotebookLM surface
# inside pi: /nlm shows a menu (select/change your current notebook, auth,
# notebooks, query, sources, doctor) and
# "Install / Remove MCP server in Docker" sets up or tears down the backend.
# The same installer can be run directly:
#   sh ~/.pi/scripts/setup-notebooklm.sh [--remove]

# 1 to ship the NotebookLM (/nlm) extension, skill, and setup script (default).
# 0 excludes the whole /nlm surface from the bundle -- the extension, the
# setup script, and the skill are not installed (also: --no-nlm).
#PI_INSTALL_NLM=1

# 1 to run the NotebookLM setup after install (installs the notebooklm-mcp-cli
# backend, provisions auth, and registers the MCP server in the Docker MCP
# gateway). Can also be done on demand via /nlm. Requires /nlm included
# (PI_INSTALL_NLM=1).
#PI_INSTALL_NOTEBOOKLM=0

# Google account (optional). nlm signs in via the browser; if set, this becomes
# the nlm profile slug. Auth state lives in ~/.notebooklm-mcp-cli (outside
# ~/.pi, survives reinstalls) -- treat it as a secret.
#NOTEBOOKLM_ACCOUNT=you@gmail.com

# Loopback port for the notebooklm-mcp HTTP server (default 9420).
#NOTEBOOKLM_MCP_PORT=9420

# Bearer token for the server; auto-generated if unset.
#NOTEBOOKLM_MCP_TOKEN=

# Docker MCP gateway profile id to register the server in (default: default).
#NOTEBOOKLM_MCP_PROFILE=default

# --- Integrity ---

# Expected SHA256 of the release tarball (optional, skipped when empty).
# Generate with: curl -sL <archive_url> | sha256sum
#PI_INSTALL_RELEASE_SHA256=

